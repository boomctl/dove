config.toml
config.local.toml

# Local test artifacts / share scratch
/shares
/scratch

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Local agent / worktree scratch
.claude/
# SDD / planning scratch — design lives in docs/designs/; specs, plans, and
